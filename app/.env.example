# JagaKebond secrets — copy to .env and fill in. NEVER commit .env.
#
# Minimal install: NINEROUTER_URL + NINEROUTER_KEY. For a VPS also set
# SECRET_KEY, WORKER_TOKEN, and ADMIN_EMAIL/ADMIN_PASSWORD.

# --- Web / security -------------------------------------------------------
# Master key for encrypting stored API keys at rest (AES-GCM). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing this makes stored API keys unreadable; the console will say so.
SECRET_KEY=

# Shared secret between the app and the worker. Required: the worker cannot claim jobs
# without it, and it is what stops a browser from reading farmers' photos.
# Use at least 32 random characters (the app logs a warning at startup when it is shorter;
# generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))").
WORKER_TOKEN=

# Secure cookies. Keep 1 on any HTTPS deployment; 0 only for local http testing.
# With 1 the app also sends Strict-Transport-Security (browsers ignore it over plain http).
COOKIE_SECURE=1

# How long a login lasts. Administrator logins are capped at 7 days whatever this says.
SESSION_TTL_DAYS=30

# Browser origins, besides the site itself, that may send state-changing /api requests.
# The app already accepts its own host (Host / X-Forwarded-Host) and the Android WebView
# origin https://localhost; requests without an Origin header (the native Android bridge,
# the worker, curl) are unaffected. List extra origins comma-separated, with scheme, e.g.
#   JK_ALLOWED_ORIGINS=https://jagake.bond,https://www.jagake.bond
# Needed only if a reverse proxy rewrites the Host header to something else.
JK_ALLOWED_ORIGINS=

# Serve the interactive API docs (/docs, /redoc) and /openapi.json. They list every route,
# admin and worker ones included, so leave this OFF (empty or 0) on a public deployment.
JK_ENABLE_API_DOCS=0

# Extra hostnames (comma-separated, exact match) that may be used as the AI router URL in
# the admin console and by the worker. 127.0.0.1, localhost and ::1 are always allowed.
# Example: JK_ROUTER_ALLOWED_HOSTS=router.internal.example
JK_ROUTER_ALLOWED_HOSTS=

# --- First-run admin ------------------------------------------------------
# Used only when the database has no admin yet. Leave ADMIN_PASSWORD empty to have a
# random one generated and printed once in the startup log.
ADMIN_EMAIL=admin@jagakebond.local
ADMIN_PASSWORD=

# Open sign-up. Closed by default: on a public deployment an open registration form
# lets anyone spend your AI quota. Create farmer accounts from /admin → Akun instead.
ALLOW_REGISTRATION=0

# "Masuk dengan Google". Empty = off (no Google button anywhere, the Google routes answer 404).
# Paste the OAuth *Web application* client ID from Google Cloud console (it is public, not a
# secret). Anyone with a Google account can then ask to join; requests wait in /admin -> Akun ->
# Pendaftaran. Several IDs may be listed comma-separated; the first is the one the web page uses.
GOOGLE_CLIENT_ID=

# Default per-account daily photo cap (0 = unlimited). Per-account overrides live in /admin.
DEFAULT_DAILY_QUOTA=0

# Insert the invented Bogor demo records (4 records / 1 daily / 2 farms) on first run.
# Leave 0 for a real deployment; set 1 only when you want sample data to click around.
# Only read at first boot — flipping it later changes nothing.
SEED_DEMO_DATA=0

# --- LLM router (vision models) -------------------------------------------
# These can also be set later from the admin console, which takes precedence.
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=

# Model routes — direct gemini/gemma-* ONLY.
# NEVER use gemma-*-local combos: they silently resolve to a non-Gemma fallback.
GEMINI_TRIAGE_MODEL=gemini/gemma-4-26b-a4b-it
GEMINI_DIAGNOSE_MODEL=gemini/gemma-4-31b-it

# Fallback only, not needed when the router holds the credentials
GEMINI_API_KEY=

# Optional n8n webhook (best-effort fan-out; the worker poll loop stays the reliable path)
N8N_ANALYZE_WEBHOOK=

# --- Queue tuning ---------------------------------------------------------
QUEUE_PACER_SECONDS=25
QUEUE_STALE_CLAIM_SEC=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_BASE=30
QUEUE_BACKOFF_MAX=600
# Must stay below nginx client_max_body_size (14m in deploy/nginx.conf). The app itself
# answers 413 before reading the body when Content-Length exceeds MAX_UPLOAD_MB + 1 MB
# (room for the multipart framing), so keep any proxy limit at least that large.
MAX_UPLOAD_MB=12

# Worker -> backend base URL
API_BASE_URL=http://127.0.0.1:8010

# Legacy /api/diagnose (optional)
PLANT_ID_API_KEY=
